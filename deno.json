{
	"name": "misskey-deno",
	"version": "2026.4.5-beta.0",
	"tasks": {
		"compile-config": "cd packages/backend && deno task compile-config",
		"dev": "deno run -A scripts/dev.ts",
		"start": "deno task compile-config && deno run -A ./built/boot/entry.js",
		"update": "pnpm i && pnpm build && pnpm migrate && pnpm start"
	},
	"workspace": [
		"packages/backend"
	],
	"exports": "./mod.ts",
	"compilerOptions": {
		"jsx": "preserve",
		"jsxImportSource": "vue"
	},
	"fmt": {
		"useTabs": true
	}
}
