{
	"name": "backend",
	"exports": "./mod.ts",
	"imports": {

		"$hono": "jsr:@hono/hono",
		"$hono/": "jsr:@hono/hono/",
		"@/": "./src/",

		"crypto": "node:crypto",
		"events": "node:events",

		"misskey-reversi": "../misskey-reversi/src/index.ts",
		"misskey-js": "../misskey-js/src/index.ts",
		"i18n/": "../i18n/src/"
	},
	"tasks": {
		"compile-config": "deno run --allow-run --allow-sys --allow-env --allow-read --allow-net --allow-write ./scripts/deno/compile_config.ts",
		"dev": "deno task compile-config && deno run --allow-net --sloppy-imports --allow-ffi --allow-read --allow-env --watch ./scripts/deno/dev.ts"
	},
	"compilerOptions": {
		"lib": [
			"deno.window",
			"deno.unstable",
			"node"
		],
		"experimentalDecorators": true
	}
}
